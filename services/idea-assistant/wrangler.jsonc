{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liberpedia-ideas",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "ai": {"binding": "AI"},
  "ratelimits": [{"name": "IDEA_LIMIT", "namespace_id": "1001", "simple": {"limit": 6, "period": 60}}],
  "vars": {"SITE_ORIGIN": "https://jelliottdev.github.io"},
  "observability": {"enabled": false}
}
