{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liberpedia-ideas",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "IDEA_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "PROPOSAL_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://jelliottdev.github.io"
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "PROPOSALS",
      "database_name": "liberpedia-proposals",
      "database_id": "02e2ac49-ed7d-4a1a-bea0-17b4de7b3ebf",
      "migrations_dir": "migrations"
    }
  ]
}
