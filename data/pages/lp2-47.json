ᛖᚷᛗᛝᚹᚻᚱᛋ-ᚢᛟᚣᛠ/\nᚷᚩᚷ-ᛇᛁᛖ-ᛠᛄᛇᛁᚾᛄᚩᛗᚱᛡᛉ-ᚠᚻᚳ-ᚪᚩᚪᚫ/\n","frequencies":{"ᛠ":11,"ᛁ":12,"ᚦ":10,"ᛒ":11,"ᛚ":8,"ᚳ":5,"ᛞ":7,"ᛇ":10,"ᚠ":9,"ᚢ":9,"ᛉ":5,"ᛋ":15,"ᚫ":15,"ᛗ":6,"ᚹ":13,"ᛈ":9,"ᛏ":7,"ᚾ":8,"ᚱ":11,"ᛡ":12,"ᚩ":12,"ᛖ":12,"ᛟ":5,"ᛄ":7,"ᚣ":10,"ᚷ":9,"ᚪ":7,"ᛝ":10,"ᚻ":9},"prime_sum":14095,"sources":[{"name":"ibotpeaches","url":"https://raw.githubusercontent.com/iBotPeaches/cicada_3301/fdda9cf7bc9e2151ca5272cd51e866991a4ea079/liber_primus/64.jpg","commit":"fdda9cf7bc9e2151ca5272cd51e866991a4ea079"},{"name":"scream314","url":"https://raw.githubusercontent.com/scream314/cicada3301/10733feb487bb8beb9966d534727ee5897aa54fc/assets/2014/liber-primus-complete/64.jpg","commit":"10733feb487bb8beb9966d534727ee5897aa54fc"},{"name":"iddqd","url":"https://raw.githubusercontent.com/cicada-solvers/iddqd/0e3789ad2949c62ea7fb9e3e00ded93df3b3ce07/liber-primus__images--full/64.jpg","commit":"0e3789ad2949c62ea7fb9e3e00ded93df3b3ce07"}],"visual":{"glyphs":[],"punctuation":[]},"corrections":[],"reviewed_text":null,"reading":null,"notes":[{"title":"Twelve runic rows within paired plant borders","text":"Twelve rows of black runes occupy the central column. Tall curling stems flank the text, with drooping narrow leaves, root-like bases, and nearby groups of filled dots. No red heading or alphanumeric grid is visible. Compare the paired borders on LP2-41–44 and the grids on LP2-49–51.","rect":[0,640,2400,2300],"source":"data/evidence/editorial-page-notes.json"},{"title":"Dotted cluster at the end of the first row","text":"A compact dotted cluster follows the last rune of the first row. Other small dots appear within the text and at row starts. Keep these textual marks separate from the larger filled dots next to the plant stems.","rect":[570,640,1260,180],"source":"data/evidence/editorial-page-notes.json"}],"transcription_sha256":"d5e6eed6db2807515d732804c5ad0c7efdc906ebd1845bd918acfdbbefb5f18e"}