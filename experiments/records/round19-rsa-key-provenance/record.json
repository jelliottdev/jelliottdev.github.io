{
  "id": "round19-rsa-key-provenance",
  "status": "published",
  "title": "Round 19 RSA key scan: source replay and provenance",
  "question": "Does the source's expanded 23-modulus RSA scan yield a padding match, and are all 23 keys actually Cicada keys?",
  "reader_question": "Did the larger RSA scan test more Cicada keys?",
  "summary": "All 738 source settings reproduce, with no structural match. The expanded set contains 20 unrelated archived PGP packets, so its larger count does not establish wider Cicada-key coverage.",
  "finding": "594 valid public-power settings produced no source-defined PKCS#1 or PSS structure; 144 inputs were invalid. The 22 parsed PGP packets comprise two Cicada packets and 20 keys archived for unrelated reasons.",
  "limitations": "This is a whole-payload public-power replay and key-provenance audit. It does not test RSA private-key decryption, other byte windows, or unknown keys. The 540 evaluated rows under unrelated keys are exploratory, not Cicada-key coverage.",
  "next_steps": "Treat a future key as a Cicada candidate only with an independent authorship or puzzle-source link; specify any new RSA block, padding, and success criterion before testing.",
  "outcome": "not-supported",
  "tags": [
    "number grid",
    "RSA",
    "PGP",
    "source audit",
    "public repository"
  ],
  "scope": {
    "pages": [
      "lp2-49",
      "lp2-50",
      "lp2-51"
    ],
    "representation": "Three pinned 256-byte grid readings as whole RSA values, two byte orders and source zero-extension alignments.",
    "procedure": "Recompute every Round 19 C1 E-01 source row under its named moduli and exponents, test source structural predicates, and derive OpenPGP fingerprints and moduli from pinned armored witnesses.",
    "parameters": "23 named moduli (22 PGP packets plus one 2013 puzzle modulus), three payload readings, source endian/alignment options, three exponents: 738 named settings, 594 valid and 144 s>=n exclusions.",
    "exclusions": "Private-key RSA operations, extra modulus witnesses, unknown keys, partial payload blocks, and alternate padding."
  },
