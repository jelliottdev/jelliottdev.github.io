{
  "id": "word-internal-affine-all-lags",
  "title": "LP2: affine patterns across twelve distances",
  "status": "published",
  "question": "Does the strongest word-internal affine relation across distances one through twelve exceed a full shuffled-word search?",
  "reader_test": {
    "input": "Archived rune text on LP2-00–55, with words ending at hyphens or periods and pages kept separate.",
    "action": "Count matches for 841 alphabet-number rules at each of twelve distances inside words, then select the strongest score against a shuffled-word baseline.",
    "check": "Repeat the entire search on 999 versions rearranged within words and compare their strongest scores with the original."
  },
  "summary": "The strongest of 10,092 measured relations is a same-rune repeat five places apart: 102 matches versus 60.6 expected. Four of 999 complete shuffled-word searches reached its standardized score. The proposed six-rune formula is not the strongest.",
  "tags": [
    "affine relation",
    "lag sweep",
    "lag 5",
    "lag 6",
    "same-rune repeat",
    "24 minus 2c",
    "mod 29",
    "word shuffle",
    "multiple testing",
    "selection effects",
    "word-internal pairs"
  ],
  "family": {
    "id": "word-internal-affine-relations",
    "title": "Affine relations within visible words",
    "question": "Do fixed rune-position relations exceed controlled word-level baselines?",
    "baseline": "word-internal-affine-lags"
  },
  "variant": {
    "label": "Follow-up: select across twelve lags and all affine maps",
    "changes": [
      {
        "field": "procedure",
        "before": "Count c′ = 24 − 2c at lag six within visible words; scan all 841 affine maps at that lag; compare with 2,000 seeded within-word shuffles.",
        "after": "For lags 1–12 and every a,b in 0–28, count c′ = ac + b modulo 29 inside visible words. Compute the exact fixed-multiset word-shuffle mean, rank by (count − mean)/sqrt(mean + 1), and retain the maximum. Repeat that complete selection on shuffled words.",
        "reason": "Repeat the entire formula and distance search on each control."
      },
      {
        "field": "parameters",
        "before": "56 unsolved pages; 1,267 word-internal opportunities; 841 affine maps c′ = ac + b modulo 29 at lag six; 2,000 shuffles.",
        "after": "12 lags × 841 affine maps = 10,092 scores; 999 independent within-word shuffles; seed 330112; at-least ties; plus-one corrected upper tail; predeclared alpha 0.05.",
        "reason": "Extend the fixed-distance scan to twelve distances with a prespecified standardized score and 999 complete controls."
      },
      {
        "field": "exclusions",
        "before": "Other page ranges or transcriptions, alternate word boundaries, other formula families, key-layer simulations, held-out prediction, and a complete decryptor.",
        "after": "Other segmentations, page subsets or releases, lags beyond 12, nonlinear relations, key/decryption searches, prior unrecorded model searches, and realistic plaintext/cipher generators.",
        "reason": "State the broader search coverage and remaining untested choices."
      }
    ]
  },
