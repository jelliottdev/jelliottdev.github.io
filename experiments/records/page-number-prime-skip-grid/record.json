{
  "id": "page-number-prime-skip-grid",
  "status": "published",
  "title": "Keys based on page order",
  "question": "Do the exact source page-number ramp keys pass their fixed English-score gates when conditional key skips are permitted?",
  "reader_question": "Can keys derived from page order decode the text?",
  "summary": "Seven complete-page outputs selected from 660 short trials all fail the source final score gate. A separate audit of every retained final candidate also finds no gate crossing.",
  "reader_finding": "These three page-assigned key rules produced no output that cleared their fixed English-score test. Only seven of the 660 short trials reached complete-page checking.",
  "reader_limit": "Only these three rules and this skip procedure were tested. Most settings received a 50-rune check; passing the score test would still need plaintext verification.",
  "bounds_note": "660 source short settings; 7 complete-page checks; 112 signed-array plants representing eight step/known-reading situations.",
  "pages_note": "55 nonempty pages LP2-00 through49 and51 through55; source index50 maps to LP2-51.",
  "tags": [
    "page-number keys",
    "numeric keys",
    "conditional skips",
    "linear ramps",
    "source replay"
  ],
  "family": {
    "id": "numeric-stream-skip-grid",
    "title": "Numeric keys with conditional skips",
    "question": "Can these numeric keys decode pages when key positions may be skipped?",
    "baseline": "numeric-stream-skip-grid"
  },
