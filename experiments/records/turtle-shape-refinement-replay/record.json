{
  "id": "turtle-shape-refinement-replay",
  "title": "The six refined turtle-shape checks",
  "status": "published",
  "question": "Do the six source-selected turtle diagnostics pass their combined 2,000-shuffle empirical and Gaussian-tail gates?",
  "summary": "Four shared surrogate series reproduce all six empirical tails and no selected diagnostic passes both source gates. A zero observed tail frequency is a sampling floor, not probability zero.",
  "pages_note": "LP2-00–49 and LP2-51–55; blank LP2-50 omitted in the source's segment numbering",
  "bounds_note": "Six selected diagnostics; four path rules; 8,000 refinement null walks; two planted-shape controls.",
  "tags": [
    "turtle graphics",
    "spatial reading",
    "reported attempt",
    "prime values",
    "geometry",
    "refinement"
  ],
  "family": {
    "id": "lp2-turtle-spatial-replay",
    "baseline": "lp2-turtle-spatial-replay",
    "title": "Turtle geometry",
    "question": "Do rune-driven paths produce distinctive shapes?"
  },
  "variant": {
    "label": "Six selected refinements",
    "changes": [
      {
        "field": "procedure",
        "before": "For each rune take its GP prime, one-based prime index, or prime totient. Turn modulo 4, 6, 8, 12, 29 or 360, using absolute or relative heading, then step by one unit or proportional to the value. Measure six declared path statistics and compare with 200 seeded histogram-preserving shuffles for every case. Run planted square and block-comb controls.",
        "after": "Replay exactly the six source-selected 2,000-shuffle refinements using frozen pure source functions. Share identical surrogate walks across diagnostics of the same rule; independently recount tails and compare coordinates, rasters and selected measures with a separate implementation. Repeat the source square and block-comb controls.",
        "reason": "Finish the source-selected later refinement stage with its exact 2,000-shuffle scope and explicit inferential limits."
      },
      {
        "field": "parameters",
        "before": "3 streams × 6 moduli × 2 turn interpretations × 2 step rules = 72 fixed constructions; 200 shuffles per construction = 14,400 null paths.",
        "after": "Six selected diagnostics across four distinct rules: value/M6/absolute/unit symmetry; value/M8/relative/value fill, symmetry and components; value/M12/absolute/unit fill; prime-index/M6/relative/unit fill. Seeds 103301..105300, 2,000 shuffles per rule = 8,000 null walks; two plants with 200 shuffles each.",
        "reason": "Finish the source-selected later refinement stage with its exact 2,000-shuffle scope and explicit inferential limits."
      },
      {
        "field": "exclusions",
        "before": "Per-page resets, pen-up markers, 3D or L-system routes, other angles or step rules, and any plaintext extraction along a path. G3 base32 and coordinate pointer framings from the broader source lane are not reimplemented in this geometric record.",
        "after": "No new 72-rule screening pass, new drawing rule, per-page reset, pen-up marker, 3D route, glyph recognition or plaintext extraction. No independently validated Gaussian-tail or familywise-probability claim. The other rules remain covered only by the earlier 200-shuffle baseline.",
        "reason": "Finish the source-selected later refinement stage with its exact 2,000-shuffle scope and explicit inferential limits."
      }
    ]
  },
