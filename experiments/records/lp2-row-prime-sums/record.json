{
  "id": "lp2-row-prime-sums",
  "title": "LP2-00–55: prime row sums against shuffled pages",
  "status": "published",
  "question": "Do the archived row boundaries on LP2-00–55 produce more prime-valued Gematria Primus row sums than within-page rune shuffles?",
  "reader_test": {
    "input": "Archived rune text on LP2-00–55, with each rune-bearing line, including headings, treated as one row.",
    "action": "Add the usual prime value of every rune in each row, then count how many row totals are prime.",
    "check": "Compare the combined count with 999 page-by-page rune shuffles that keep the original row lengths."
  },
  "summary": "76 of 594 eligible row sums are prime. Of 999 shuffled datasets, 843 have at least as many; corrected one-sided p=0.844. No evidence of an excess under this model.",
