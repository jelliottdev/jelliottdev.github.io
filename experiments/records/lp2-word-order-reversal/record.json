{
  "id": "lp2-word-order-reversal",
  "title": "LP2-00–55: reverse the order of word-like segments",
  "status": "published",
  "question": "Does reversing the order of declared word-like segments, while preserving runes inside each segment, recover any of nine known 12-rune openings on LP2-00–55?",
  "summary": "Reverse segment order while keeping each segment forward. Two boundary rules produce 110 distinct outputs; none matches nine fixed beginnings.",
  "tags": [
    "word order reversal",
    "reverse word order",
    "last word first",
    "backwards",
    "word boundaries",
    "transposition",
    "reading order"
  ],
  "family": {
    "id": "archived-layout-reading-routes",
    "title": "Reading routes through archived rune layouts",
    "question": "Do predefined layout traversal rules recover explicitly specified openings without changing rune values?",
    "baseline": "lp2-row-column-routes"
  },
  "variant": {
    "label": "Reverse segment order under two boundary conventions",
    "changes": [
      {
        "field": "representation",
        "before": "Keep every recognized rune including headings, grouped by archived source line. Ignore non-rune characters and lines with no runes. Retain original line and within-line rune positions. LP2-50 is retained as a zero-rune page, with no candidate routes. Left-align rune rows by within-row ordinal. Unequal row lengths remain unequal. Missing cells are skipped, not padded. Ordinal columns are not asserted to be physical image columns.",
        "after": "All recognized runes, including headings. Rune order inside each segment stays unchanged. Split-lines: every non-rune terminates a segment. Join-lines: ignore slash, CR and LF before segmentation; every other non-rune terminates a segment. These are transcription-defined segments, not independently established plaintext words. LP2-50 has no runes and contributes no candidates.",
        "reason": "Group runes by explicit segment boundaries rather than archived rows and ordinal columns."
      },
      {
        "field": "procedure",
        "before": "Enumerate row-first and column-first routes, both outer directions, both initial inner directions, and constant/alternating inner direction. Preserve every source position and compare the first 12 output indices with nine fixed known openings.",
        "after": "Reverse the order of all segments across the complete page, then concatenate their runes without changing within-segment order. No within-segment reversal, alphabet substitution, heading removal or later-position search. Compare the first 12 output indices with nine fixed known beginnings.",
        "reason": "Reverse the complete page’s segment order while retaining forward order inside every segment."
      },
      {
        "field": "parameters",
        "before": "16 route configurations per nonempty page; 55 nonempty pages; 880 cases; 7920 exact opening comparisons. No substitution or later-position search.",
        "after": "Two declared boundary conventions per nonempty page: split-lines and join-lines. 55 nonempty pages, 110 candidates, 990 exact opening comparisons.",
        "reason": "Use two boundary conventions per page instead of sixteen row/column routes."
      },
      {
        "field": "exclusions",
        "before": "Arbitrary column permutations, spiral paths, rectangular reflow, physical x-coordinate alignment, heading removal, substitution, alternative openings and other text regions.",
        "after": "Within-segment reversal, reversal limited to each row, arbitrary regrouping, heading removal, additional substitution, later-position search, alternative openings and general language ranking.",
        "reason": "Keep this follow-up separate from within-segment, row-local and combined transformations."
      }
    ]
  },
