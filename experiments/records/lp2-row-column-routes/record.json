{
  "id": "lp2-row-column-routes",
  "title": "LP2-00–55: simple row and column reading routes",
  "status": "published",
  "reader_test": {
    "input": "Archived rune rows from LP2-00 through LP2-55, including headings, with columns defined by position within each recorded row rather than measured image alignment.",
    "action": "Read rows or columns in 16 fixed orders, including reversals and alternating directions, skipping missing cells without padding uneven rows into a rectangle.",
    "check": "A route passes only if its first 12 runes exactly match the beginning of one of nine known readings; an independent checker also reconstructs every output from its source positions."
  },
  "question": "Can reading the LP2-00–55 runes by rows or columns recover one of nine known passage openings without changing the runes?",
  "summary": "All 880 parameter routes completed on 55 rune-bearing pages; none matched the nine declared openings. Each output retains its complete source-coordinate trace. LP2-50 has no eligible runes.",
  "pages_note": "LP2-00–55 · 55 contain runes; LP2-50 is empty",
  "bounds_note": "16 routes per page × 55 pages = 880 candidates; each checked against nine known openings. No substitution or later-position search.",
  "tags": [
    "transposition",
    "reading order",
    "reverse",
    "columns",
    "rows",
    "boustrophedon",
    "alternating direction",
    "route cipher"
