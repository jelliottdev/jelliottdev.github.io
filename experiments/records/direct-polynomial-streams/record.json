{
  "id": "direct-polynomial-streams",
  "title": "LP2-00–55: direct polynomial streams, degree at most eight",
  "status": "published",
  "question": "Can a fixed-modulus integer polynomial of degree at most eight directly generate each page, in index or prime coordinates?",
  "summary": "All 880 page/representation/degree checks have difference gcd 1, excluding this direct-output model for every modulus greater than one. Polynomial keys mixed with plaintext are not tested.",
