{
  "id": "image-row-coverage",
  "title": "Can image-only detection find every rune row?",
  "status": "published",
  "question": "Does a fixed image-only horizontal-projection detector recover every individually annotated rune row across eight selected page layouts?",
  "summary": "Eight page overlays show where a fixed image-only detector merges rune rows or proposes artwork and other text. A separate implementation verifies the interval matches.",
  "tags": [
    "transcription",
    "missing line",
    "whole line omission",
    "row detection",
    "image segmentation",
    "image-only",
    "coverage",
    "OCR"
  ],
  "scope": {
    "pages": [
      "lp2-00",
      "lp2-03",
      "lp2-15",
      "lp2-31",
      "lp2-39",
      "lp2-50",
      "lp2-56",
      "lp2-57"
    ],
    "artifacts": [
      "images/lp2-00.jpg",
      "images/lp2-03.jpg",
      "images/lp2-15.jpg",
      "images/lp2-31.jpg",
      "images/lp2-39.jpg",
      "images/lp2-50.jpg",
      "images/lp2-56.jpg",
      "images/lp2-57.jpg"
    ],
    "representation": "Original JPEG grayscale horizontal projections and frozen manual half-open rune-body intervals; no canonical transcription input.",
    "procedure": "Fixed image-only proposals; maximum-cardinality one-to-one interval matching; each annotated rune row separately omitted from a hypothetical candidate inventory while the image stays unchanged.",
    "parameters": "Central 22\u201378% width; grayscale <128; active ink >1%; discard active heights <20 before merging gaps <12 pixels; interval IoU >=0.5; eight selected images and 65 rune reference rows.",
    "exclusions": "No rune recognition, actual omitted archive line finding, classifier accuracy claim, whole-book certification, random-sample inference or threshold tuning."
  },
  "outcome": "not-supported",
  "finding": "The fixed detector does not recover all individual rune rows: 43 of 65 match. Its 83 proposals comprise 43 individual rune rows, 24 other text rows, seven merged rune-row bands and nine artwork bands.",
  "limitations": "Selected layouts and approximate manual intervals, not independent random trials. Both implementations use Pillow decoding. Prior page familiarity is disclosed; human annotation review remains pending.",
  "next_steps": "Compare explicitly declared segmentation variants against this baseline, preserving all misses and non-runic proposals; add independently reviewed references before broadening coverage claims.",
  "family": {
    "id": "image-row-coverage",
    "title": "Image-only row coverage",
    "question": "Can image segmentation independently cover the text rows that a transcription comparison needs?",
    "baseline": "image-row-coverage"
  },
  "variant": {
    "label": "Fixed central-column projection on eight layouts",
    "changes": []
  },
