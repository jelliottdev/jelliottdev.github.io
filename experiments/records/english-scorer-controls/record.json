    ],
    "representation": "Eight aligned FLORES devtest translations; uppercase A\u2013Z and accent-folded uppercase A\u2013Z.",
    "procedure": "Score fixed prefixes from eight aligned blocks and twenty deterministic letter shuffles per cell with the pinned English quadgram model.",
    "parameters": "Eight languages; 120, 240, 400 letters; two normalizations; threshold -5.5; 384 original cells and 7680 shuffles.",
    "exclusions": "No cipher, decoder, manuscript score, language identification, wrong-key search, recovery-power estimate or general false-positive probability."
  },
  "outcome": "supported",
  "finding": "Acceptance depends on language: all English and French originals pass, some German, Italian, Portuguese and Spanish pass, and no Finnish or Welsh originals pass. No shuffled control passes.",
  "limitations": "Nested lengths and shared translated sources are not independent trials. Training overlap is not excluded. Shuffles are not complete wrong-key searches. Human review pending.",
  "next_steps": "Separate planted-decoder recovery from scorer acceptance; calibrate maxima from complete bounded null searches.",
