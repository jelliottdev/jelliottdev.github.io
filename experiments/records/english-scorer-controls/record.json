{
  "id": "english-scorer-controls",
  "title": "Would an English scorer accept other languages?",
  "status": "published",
  "question": "Does a fixed English quadgram threshold accept known text and reject letter shuffles across eight languages?",
  "summary": "Known-text controls isolate language sensitivity in candidate scoring, with all eight languages, two normalization rules and three lengths retained.",
