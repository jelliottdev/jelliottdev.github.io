  "representation": "For each page, concatenate canonical GP Latin labels for runes in archived line order; omit punctuation and word/line gaps. One page is one uppercase A-Z token, matching source cin token input. The 11-letter key clock advances per Latin character, including F and characters inside multigraph labels, and resets at each page.",
  "key": "AIRAUMFERAE",
  "period": 11,
  "phase": 0,
  "source_operators": {
    "ordinary_plus": "Y_i=(X_i+K_{i mod 11}) mod 26",
    "f_preserving_plus": "Y_i=F if X_i=F, otherwise (X_i+K_{i mod 11}) mod 26. Key clock still advances on F."
  },
  "branch_tests": {
    "ordinary": "Only this branch is bijective. Subtract the fixed key at each Latin character of each LP2 page, then score its full output. Source + transform and independent formula must agree on synthetic fixture.",
    "f_preserving": "Do not invert. Test exact image membership of each LP2 page under the source + operator: for every slot with K!=A, the output letter F+K modulo26 is impossible. At K=A all 26 outputs are possible. Report count and first index per page."
  },
  "source_parity_fixture": {
    "input": "ABCDEFGHIJKLFABC",
    "ordinary_plus": "AJTDYRLLZJOLNRBW",
    "f_preserving_plus": "AJTDYFLLZJOLFRBW"
  },
  "collision_control": {
    "inputs": [
      "AF",
      "AX"
    ],
    "f_preserving_plus": "AF",
    "explanation": "At key slot1 I=8, both F (preserved) and X (23+8 mod26=F) output F; no inverse exists."
  },
  "f_image_controls": "Exhaustively enumerate all 26 possible source inputs at each of 11 key slots. Source-generated outputs must have zero forbidden letters; replacing a nonzero-key slot output with F+K must fail membership. These controls define the exact membership predicate before LP2.",
