    "shuffle_seed": 671881,
    "required_originals": 8,
    "plant_rule": "Apply source ordinary + transform to each known-reading GP Latin prefix; subtract fixed key and recover the exact prefix; require all nine recoveries.",
    "note": "Score true prefixes and 200 within-prefix rune shuffles as in the existing whole-page known-key control, but key clocks over Latin characters."
  },
  "global_null": {
    "rule": "199 seeded replicates: independently shuffle rune order within each of the 55 pages, expand GP Latin labels, subtract the fixed 26-letter key, and retain the single highest complete-page quadgram score.",
    "replicates": 199,
    "seed": 671882
  },
  "limits": "The source takes one uppercase A-Z token, not GP rune indices. This convention-dependent application to full LP2 pages was not documented as an original manuscript sweep. No other key, phase, reset, alphabet mapping, language or dynamic Playfair construction is tested. Passing F image membership would be necessary, not sufficient, for a source-operator explanation."
